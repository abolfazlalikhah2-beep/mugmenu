// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A cafe/restaurant tenant, published at /{slug}. See CLAUDE.md's
// multi-tenant note.
model Business {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  nameEn               String?
  logoUrl              String?
  address              String?
  phone                String?
  // Precise pin for the dashboard's Google Maps picker (Business Info tab)
  // and the public menu's business-info-modal map embed — independent of
  // the free-text `address` line above, which stays unvalidated/unparsed.
  latitude             Float?
  longitude            Float?
  description          String?
  isAcceptingOrders    Boolean  @default(true)
  acceptsDineIn        Boolean  @default(true)
  acceptsTakeaway      Boolean  @default(true)
  acceptsDelivery      Boolean  @default(false)
  acceptsOnlinePayment Boolean  @default(false)
  acceptsCashPayment   Boolean  @default(true)
  packagingFee         Int      @default(12000)
  // Applied to every order's subtotal at checkout (see order-flow.ts's
  // computeServiceFee/computeTax) — independent percentages, both 0 by
  // default so existing businesses see no change until configured.
  serviceFeePercent    Int      @default(0)
  taxPercent           Int      @default(0)
  prepTimeDineIn       Int      @default(15)
  prepTimeTakeaway     Int      @default(20)
  prepTimeDelivery     Int      @default(45)
  qrShowInfo           Boolean  @default(true)
  qrShowHours          Boolean  @default(true)
  qrShowLogo           Boolean  @default(true)
  // Menu Appearance (dashboard "ظاهر منو" tab, from Admin Menu Appearance
  // dc.html) — accentColor overrides --color-brand for this business's
  // whole public menu (see app/(public)/[cafeSlug]/layout.tsx). heroBgKey
  // is one of features/menu/utils/hero-background.ts's HERO_BG_KEYS
  // ("photo" uses heroImageUrl, the rest are fixed gradient presets).
  accentColor          String   @default("#328C3D")
  heroBgKey            String   @default("g1")
  heroImageUrl         String?
  heroOverlayOpacity   Int      @default(45)
  // Menu Language (dashboard "زبان" tab, from Menu Language Toggle dc.html).
  // Only fa (default) / en (secondary) are supported today — see
  // features/menu/services/menu-language.ts — so there's no stored
  // default/secondary language pair, just whether the bilingual UI is on.
  bilingualMenuEnabled     Boolean @default(false)
  askLanguageOnEntry       Boolean @default(true)
  rememberCustomerLanguage Boolean @default(true)
  // No real SMS provider chosen yet (phase 3, see CLAUDE.md) — see
  // lib/sms/sms-provider.ts. smsConnected/smsCreditCount are set by the
  // mock provider's "save and test connection" action.
  smsProvider          String?
  smsUsername          String?
  smsApiKey            String?
  smsSenderNumber      String?
  smsConnected         Boolean  @default(false)
  smsCreditCount       Int?
  // Subscription plan/feature gating (see features/plans) — no self-service
  // purchase yet (phase 3, see CLAUDE.md), so planId is only changed by a
  // super admin (پنل داخلی ماگ‌منو "تغییر پلن") or by /onboarding, both of
  // which default new/backfilled businesses to menu-advanced so nobody loses
  // access mid-transition. billingCycle only affects which of
  // Plan.monthlyPrice/annualPrice is charged, not feature access.
  planId               String
  plan                 Plan          @relation(fields: [planId], references: [id])
  billingCycle         BillingCycle @default(MONTHLY)
  planMaxUsers         Int      @default(5)
  planStartedAt        DateTime @default(now())
  planExpiresAt        DateTime @default(dbgenerated("(now() + interval '30 days')"))
  // Captured at onboarding (dashboard "نام دامنه اختصاصی" field), only
  // shown/enabled for businesses on menu-order/menu-advanced (domain.custom
  // feature) — no DNS/provisioning yet, just storage (see CLAUDE.md).
  customDomain         String?
  // Set from the super admin panel (تعلیق پنل) — enforced in
  // requireBusinessOwner(), not just a UI flag.
  isSuspended          Boolean  @default(false)
  // Super-admin demo trial (پنل سوپرادمین › "مدیریت دمو آزمایشی") — while
  // isDemoActive is true and demoExpiresAt is in the future, the business is
  // treated as menu-advanced for feature gating regardless of planId (see
  // features/plans/services/demo-access.ts's isDemoEffective, consumed by
  // plan-service.ts). Expiry is checked at read time, no cron involved.
  isDemoActive         Boolean   @default(false)
  demoExpiresAt        DateTime?
  // Loyalty Club cashback settings (dashboard "باشگاه مشتریان" › "کش‌بک"
  // tab) — drives features/customer/services/loyalty.ts's computeCashback,
  // replacing what used to be a hardcoded 5% constant. Wallet redemption at
  // checkout is order-service.ts's own step (features/customer/wallet-service
  // just debits the ledger). Earned-credit expiry is still out of scope —
  // would need a cron scheduler this app doesn't have.
  cashbackEnabled          Boolean  @default(true)
  cashbackPercent          Int      @default(5)
  cashbackCapPerOrder      Int      @default(50000)
  // Birthday message template (dashboard "باشگاه مشتریان" › "پیام تولد"
  // tab). Settings + manual test-send only — no birthDate field exists on
  // CustomerAccount and there's no cron scheduler in this app, so automatic
  // daily sending isn't built (same category as the mock SMS provider).
  birthdayMessageEnabled   Boolean  @default(false)
  birthdayMessageText      String?
  birthdayGiftAmount       Int      @default(50000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owners       User[]
  hours        BusinessHours[]
  categories   Category[]
  products     Product[]
  orders       Order[]
  reviews      Review[]
  discounts    Discount[]
  printers     Printer[]
  contacts     Contact[]
  menuVisits   MenuVisit[]
  smsMessages  SmsMessage[]
  tickets      Ticket[]
  transactions Transaction[]
  customers    CustomerAccount[]
  couriers     Courier[]
  paymentRequests PaymentRequest[]
  creditRecords   CreditRecord[]
}

// Per-day working hours (public menu "ساعت کاری" accordion + dashboard
// settings). Replaces the old single Business.openingHoursStart/End range —
// every business gets exactly 7 rows (one per JS Date#getDay() value, same
// 0=Sunday..6=Saturday convention as Category.scheduleDays), backfilled/
// defaulted to isClosed=false, 09:00-22:00. Pure evaluation (isOpenNow,
// day labels) lives in features/menu/utils/business-hours.ts.
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  isClosed   Boolean  @default(false)
  openTime   String   @default("09:00")
  closeTime  String   @default("22:00")

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// One of the 3 fixed subscription tiers (منو دیداری / منو سفارش / منو
// پیشرفته) — see features/plans/feature-matrix.ts, the single source of
// truth used to seed PlanFeature below. Prices are snapshotted here (not
// computed from a formula at read time) so changing a price doesn't retroactively
// change what a business was quoted; features/plans reads these + monthlyPrice/
// annualPrice, never a hardcoded plan-name string comparison.
model Plan {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  monthlyPrice Int
  annualPrice  Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features   PlanFeature[]
  businesses Business[]
}

// Row presence = the plan includes featureKey; absence = it doesn't.
// limitValue holds a plan-specific limit ("1"/"3" branches, "2"/"unlimited"
// printers) or is null for a plain boolean feature — see
// features/plans/services/plan-service.ts for the read side. Editing rows
// here (not code) is how the feature matrix changes post-launch.
model PlanFeature {
  id         String  @id @default(cuid())
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  limitValue String?

  @@unique([planId, featureKey])
  @@index([planId])
}

enum UserRole {
  OWNER
  MENU_MANAGER
  CASHIER
}

// ماگ‌منو internal staff role (super admin), orthogonal to the
// business-scoped UserRole above. Only set when isSuperAdmin is true.
enum PlatformRole {
  OWNER
  ADMIN
  SUPPORT
  FINANCE
  VIEWER
}

// Restaurant owner / staff login (see lib/auth). A freshly self-registered
// user defaults to OWNER (they become the owner once /onboarding creates
// their business); staff added later from /dashboard/users get an explicit
// role and are linked to businessId at creation, skipping onboarding.
//
// isSuperAdmin/platformRole/platformTeam are for ماگ‌منو's own internal
// staff (features/superadmin, "پنل داخلی ماگ‌منو") — those rows have
// businessId null and never go through onboarding. There is no separate
// super-admin login: it's the same phone/password session, gated by
// requireSuperAdmin() instead of requireBusinessOwner(). No self-service
// signup for this — accounts are bootstrapped via prisma/seed.ts or
// invited from the super-admin Team Users page (see team-service.ts).
model User {
  id           String        @id @default(cuid())
  phone        String        @unique
  passwordHash String
  fullName     String
  businessId   String?
  business     Business?     @relation(fields: [businessId], references: [id])
  role         UserRole      @default(OWNER)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  isSuperAdmin Boolean       @default(false)
  platformRole PlatformRole?
  platformTeam String?
  createdAt    DateTime      @default(now())

  assignedTickets Ticket[] @relation("TicketAssignedAgent")
}

enum OtpPurpose {
  REGISTER
  RESET
  CUSTOMER_LOGIN
}

// Staff phone+password login's OTP step (register/forgot-password —
// features/auth/services/otp-service.ts). Not the same as the public menu's
// customer OTP (CustomerAccount is a separate identity, see its comment).
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  icon       String?
  imageUrl   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  // Optional day/time visibility window (dashboard "زمان‌بندی نمایش") — a
  // category can be active but still hidden from the public menu outside its
  // window. Pure evaluation logic lives in features/menu/utils/category-schedule.ts
  // so it's testable without a clock/DB. scheduleDays uses JS Date#getDay()
  // values (0=Sunday..6=Saturday); an empty array means "every day".
  scheduleEnabled Boolean  @default(false)
  scheduleDays    Int[]    @default([])
  scheduleStart   String?
  scheduleEnd     String?

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id])
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  // English translation for the bilingual customer menu (dashboard "زبان" ›
  // "ترجمه آیتم‌های منو"). Optional — untranslated items fall back to the
  // Persian name/description on the public menu (see menu-language.ts).
  nameEn          String?
  descriptionEn   String?
  price           Int
  discountPercent Int?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Inventory tracking (dashboard "پیگیری موجودی") — opt-in per product.
  // When trackInventory is on and stock hits 0, the product shows as
  // "ناموجود" everywhere and checkout is blocked server-side (order-service.ts).
  // lowStockThreshold only drives the dashboard's "موجودی کم" badge, not
  // ordering behavior.
  trackInventory    Boolean @default(false)
  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)

  orderItems   OrderItem[]
  reviews      Review[]
  discounts    Discount[]
  menuVisits   MenuVisit[]
  optionGroups ProductOptionGroup[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([categoryId])
}

// Admin-authored variant groups on a product (e.g. سایز، نوع نان، نوع برنج).
// Single-select per group on the public menu unless multiSelect is set (e.g.
// افزودنی‌ها), in which case customers can pick any number of its options.
// Required groups force at least one selection (a default option, when set,
// pre-selects it for single-select groups).
model ProductOptionGroup {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  required    Boolean  @default(false)
  multiSelect Boolean  @default(false)
  sortOrder   Int      @default(0)

  options ProductOption[]

  @@index([productId])
}

model ProductOption {
  id         String             @id @default(cuid())
  groupId    String
  group      ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  extraPrice Int                @default(0)
  isDefault  Boolean            @default(false)
  sortOrder  Int                @default(0)

  @@index([groupId])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  DELIVERED
  CANCELED
}

// How the order was settled — CASH/CARD are paid in full at order time;
// CREDIT (نسیه) means payment is deferred and tracked via CreditRecord
// below (features/credits). Defaults to CASH since this only matters for
// manual/POS orders today — the public online-order flow always pays in
// full through the (mock) gateway or wallet, never on credit.
enum OrderPaymentMethod {
  CASH
  CARD
  CREDIT
}

model Order {
  id                String           @id @default(cuid())
  // Human-readable sequential number shown in the dashboard/receipts instead
  // of the cuid id (which is opaque and not meant for print). Not the
  // primary key — just a display/reference number.
  orderNumber       Int              @unique @default(autoincrement())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id])
  type              OrderType
  status            OrderStatus      @default(NEW)
  paymentMethod     OrderPaymentMethod @default(CASH)
  customerName      String
  customerPhone     String
  tableNumber       String?
  address           String?
  location          String?
  estimatedTime     String?
  totalPrice        Int
  // Bill breakdown, snapshotted at checkout so it survives later changes to
  // Business.serviceFeePercent/taxPercent/packagingFee or to the discount
  // that applied. Nullable and left unset on orders placed before this
  // breakdown existed — UI code must treat serviceFeeAmount === null as
  // "no breakdown recorded" and fall back to the old combined display,
  // never as "zero fee was charged".
  subtotal             Int?
  packagingFeeAmount   Int?
  serviceFeeAmount     Int?
  taxAmount            Int?
  discountAmount       Int?
  discountName         String?
  walletRedeemedAmount Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // Set when the order was placed while the customer was logged in to their
  // account for this business (see features/customer). Null for guest
  // checkout, which is still fully supported — logging in is additive.
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id])

  // Internal courier assigned to a DELIVERY order (dashboard "پیک‌ها" ›
  // تخصیص پیک on the order detail page). SetNull so deleting a courier never
  // blocks on their order history — the order just reverts to unassigned.
  courierId String?
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  walletTransactions WalletTransaction[]
  reviews            Review[]
  survey             OrderSurvey?
  creditRecord       CreditRecord?

  @@index([businessId])
  @@index([customerAccountId])
  @@index([courierId])
}

enum CreditStatus {
  UNPAID
  PARTIAL
  PAID
}

// One row per نسیه (buy-now-pay-later) manual order — created automatically
// when a cashier submits a manual order with paymentMethod CREDIT (see
// features/dashboard/services/order-mgmt-service.ts). Settling is manual,
// partial payments accumulate in paidAmount (features/credits/services
// /credit-service.ts's settleCreditRecord) — there's no payment gateway or
// SMS reminder wired to this, same phase-3 gap as everything else in
// CLAUDE.md.
model CreditRecord {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id])
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id])
  customerName  String
  customerPhone String
  amount        Int
  notes         String?
  status        CreditStatus @default(UNPAID)
  paidAmount    Int          @default(0)
  createdAt     DateTime     @default(now())
  settledAt     DateTime?

  @@index([businessId])
  @@index([businessId, status])
}

enum CourierVehicleType {
  MOTORCYCLE
  CAR
}

// In-house delivery staff a business manages itself (not a third-party
// dispatch integration — see CLAUDE.md phase 3 for that). Assigned to
// DELIVERY orders from the order detail page.
model Courier {
  id            String             @id @default(cuid())
  businessId    String
  business      Business           @relation(fields: [businessId], references: [id])
  name          String
  phone         String
  vehicleType   CourierVehicleType @default(MOTORCYCLE)
  nationalCode  String?
  coverageZones String[]           @default([])
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  orders Order[]

  @@index([businessId])
}

// End-customer identity for the public menu (phone + OTP, see
// features/customer) — scoped per business: the same phone number at two
// different restaurants is two separate accounts/wallets, since each
// restaurant's cashback/loyalty program is its own. Distinct from User
// (staff, phone+password login) — there is no overlap between the two.
model CustomerAccount {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  phone         String
  fullName      String
  walletBalance Int      @default(0)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  addresses          CustomerAddress[]
  walletTransactions WalletTransaction[]
  orders             Order[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model CustomerAddress {
  id                String          @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id])
  title             String
  text              String
  phone             String
  isDefault         Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([customerAccountId])
}

enum WalletTransactionType {
  CASHBACK_EARNED
  ADJUSTMENT
  // Spent at checkout to reduce a new order's total — see
  // order-service.ts's wallet redemption step and Order.walletRedeemedAmount.
  REDEEMED
}

// Wallet ledger. CASHBACK_EARNED/REDEEMED are order-linked credits/debits;
// ADJUSTMENT is a manual admin correction.
model WalletTransaction {
  id                String                @id @default(cuid())
  customerAccountId String
  customerAccount   CustomerAccount       @relation(fields: [customerAccountId], references: [id])
  orderId           String?
  order             Order?                @relation(fields: [orderId], references: [id])
  type              WalletTransactionType
  amount            Int
  note              String?
  createdAt         DateTime              @default(now())

  @@index([customerAccountId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  // Customer-entered free-text note for this line (e.g. "کباب کم‌نمک باشد").
  note      String?

  options OrderItemOption[]

  @@index([orderId])
}

// Snapshot of a selected product option at order time — a snapshot rather
// than a relation to ProductOption so it stays correct even if the option
// is later renamed/repriced/deleted.
model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  optionName  String
  extraPrice  Int

  @@index([orderItemId])
}

enum DiscountType {
  CODE
  AUTOMATIC
}

enum DiscountScope {
  ALL_MENU
  CATEGORY
  PRODUCT
}

// CODE: manual promo code (customer enters it). AUTOMATIC: applied to
// matching cart items with no code — scope decides which items (see
// features/dashboard/services/discount-service.ts).
model Discount {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  type        DiscountType
  name        String
  description String?
  code        String?
  percent     Int?
  scope       DiscountScope?
  categoryIds String[]       @default([])
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@unique([businessId, code])
  @@index([businessId])
}

enum PrinterConnectionType {
  NETWORK
  USB
  BLUETOOTH
}

// Receipt printer registered by the business. Connection is device
// metadata only — actual printing goes through lib/printing (mocked
// until a real driver/agent is wired up in phase 3, see CLAUDE.md).
model Printer {
  id             String                @id @default(cuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id])
  name           String
  model          String?
  connectionType PrinterConnectionType @default(NETWORK)
  ipAddress      String?
  port           String?
  paperSize      String                @default("80mm")
  copies         Int                   @default(1)
  isConnected    Boolean               @default(false)
  lastTestedAt   DateTime?
  createdAt      DateTime              @default(now())

  @@index([businessId])
}

// SMS phonebook entry for the admin messages panel (features/dashboard,
// "پیام‌ها"). Distinct from Order.customerPhone — this is a manually
// curated list, not derived from order history (see aggregate-customers.ts
// for the derived "audience" segments used by bulk send).
model Contact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  phone      String
  createdAt  DateTime @default(now())

  @@unique([businessId, phone])
  @@index([businessId])
}

enum SmsAudience {
  ALL_CONTACTS
  // Kept for historical SmsMessage rows already sent with this audience —
  // no longer offered in the Messages composer (superseded by
  // LOYALTY_MEMBERS, a real CustomerAccount-based audience owned by the
  // Loyalty Club tab; see dashboard-schemas.ts's bulkSmsSchema).
  LOYAL_CUSTOMERS
  RECENT_ORDERS
  MANUAL
  // Real باشگاه مشتریان members (CustomerAccount rows), sent from the
  // Loyalty Club "ارسال پیام" tab — see loyalty-club-service.ts.
  LOYALTY_MEMBERS
}

enum SmsMessageStatus {
  SENT
  PARTIAL
  FAILED
  QUEUED
}

// One row per single or bulk send from the admin messages panel — the
// send history log, not a delivery queue (sending is synchronous through
// the mock provider for now, see lib/sms/sms-provider.ts).
model SmsMessage {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  text           String
  audience       SmsAudience?
  recipientCount Int
  status         SmsMessageStatus
  createdAt      DateTime         @default(now())

  @@index([businessId])
}

enum TicketStatus {
  OPEN
  PENDING
  ANSWERED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  PAYMENT
  BILLING
  GENERAL
}

enum TicketAuthorType {
  OWNER
  AGENT
}

// Support ticket filed by a business (any staff member, see
// requireBusinessOwner). No superadmin/agent panel exists yet (phase 3,
// see CLAUDE.md) so in practice every message today is authorType OWNER —
// the AGENT side is modeled so a future support panel can post replies
// without a schema change.
enum TicketPriority {
  HIGH
  MID
  LOW
}

model Ticket {
  id                  String         @id @default(cuid())
  businessId          String
  business            Business       @relation(fields: [businessId], references: [id])
  ticketNumber        Int            @unique @default(autoincrement())
  subject             String
  category            TicketCategory
  priority            TicketPriority @default(MID)
  status              TicketStatus   @default(OPEN)
  assignedAgentUserId String?
  assignedAgent       User?          @relation("TicketAssignedAgent", fields: [assignedAgentUserId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  messages TicketMessage[]

  @@index([businessId])
}

model TicketMessage {
  id             String           @id @default(cuid())
  ticketId       String
  ticket         Ticket           @relation(fields: [ticketId], references: [id])
  authorType     TicketAuthorType
  authorName     String
  text           String
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime         @default(now())

  @@index([ticketId])
}

enum TransactionStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

// One row per subscription charge. Nothing writes PENDING/FAILED yet — no
// real payment gateway is connected (phase 3, see CLAUDE.md and
// lib/payments/payment-gateway.ts), so today every row comes from a super
// admin's manual renewal (features/superadmin, always PAID). The finance
// page's revenue stats are computed from these rows, not fabricated.
model Transaction {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id])
  amount     Int
  planName   String
  status     TransactionStatus
  createdAt  DateTime          @default(now())

  @@index([businessId])
}

enum PaymentRequestStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Bank card the platform accepts manual card-to-card transfers on — stands
// in for a real payment gateway for now (see CLAUDE.md phase 3). Business
// owners on the /payment page are shown one random active card
// (features/payments/services/payment-service.ts's pickRandomActiveCard);
// the super admin "تنظیمات پرداخت" page manages the pool.
model PaymentCard {
  id            String   @id @default(cuid())
  bankName      String
  cardNumber    String
  accountNumber String
  holderName    String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  paymentRequests PaymentRequest[]
}

// One row per business's card-to-card transfer claim, created after they
// manually transfer money on the /payment page. A super admin cross-checks
// it against their bank statement and sets referenceNumber/status/notes on
// the same "درخواست‌های پرداخت" review — VERIFIED also calls
// changeBusinessPlan with whichever plan the admin picks then, since there's
// no automatic plan inference from the transfer amount.
model PaymentRequest {
  id              String               @id @default(cuid())
  businessId      String
  business        Business             @relation(fields: [businessId], references: [id])
  amount          Int
  assignedCardId  String
  assignedCard    PaymentCard          @relation(fields: [assignedCardId], references: [id])
  referenceNumber String?
  screenshotUrl   String?
  status          PaymentRequestStatus @default(PENDING)
  notes           String?
  createdAt       DateTime             @default(now())
  verifiedAt      DateTime?

  @@index([businessId])
  @@index([assignedCardId])
}

// Single-row platform-wide settings (payment gateway credentials for
// collecting subscription fees). Not per-business — see
// features/superadmin/repositories/superadmin-repository.ts for the
// get-or-create-singleton helper.
model PlatformSettings {
  id                  String   @id @default(cuid())
  gatewayEnabled      Boolean  @default(true)
  zarinpalMerchantId  String?
  zarinpalApiKey      String?
  zarinpalCallbackUrl String?
  zarinpalSandbox     Boolean  @default(true)
  zarinpalConnected   Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// Item-level (productId set) or restaurant-level (productId null) review.
model Review {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  // Set when submitted from the post-order review flow (see
  // features/menu/services/review-service.ts). Null for reviews without a
  // known order (none exist yet outside seed data, but the field stays
  // optional rather than backfilling a fake order).
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])
  customerName String
  // Hides customerName in customer-facing review lists; the name is still
  // stored (needed for the existing @@unique constraint below and for the
  // admin panel), just not displayed. Set from the review form's "ثبت
  // به‌صورت ناشناس" toggle.
  anonymous    Boolean  @default(false)
  rating       Int
  comment      String?
  // Fixed quick-pick chips from the review form (see TAG_OPTIONS in
  // review-schemas.ts) — free text, not an enum, since they're display-only
  // and not used for filtering/reporting yet.
  tags         String[] @default([])
  createdAt    DateTime @default(now())

  @@unique([productId, customerName])
  @@index([businessId])
  @@index([productId])
  @@index([orderId])
}

// The optional 3-question quick survey shown as a bottom sheet on the
// receipt page right after an order (see Customer Feedback.dc.html) —
// deliberately separate from Review: it's about the order/delivery
// experience, not a specific product, and has its own fixed answer sets.
model OrderSurvey {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  // English keys validated by review-schemas.ts's TASTE/SPEED/PACKAGING
  // option lists; mapped to Persian labels in the UI, same convention as
  // OrderType/TYPE_LABEL.
  taste     String
  speed     String
  packaging String
  createdAt DateTime @default(now())
}

// Traffic source for a menu-entry visit, resolved in
// features/menu/services/visit-source.ts from a ?src=qr link convention
// (table QR codes) vs. the HTTP referer (external link vs. no referer =
// typed/bookmarked direct visit). Null on item-detail-view rows (productId
// set) — source is only meaningful for the entry landing, not sub-navigation.
enum VisitSource {
  QR
  LINK
  DIRECT
}

// One row per public menu visit — see Admin Menu Analytics (dashboard
// "گزارش‌ها" › "آمار بازدید منو" tab). productId null + source set = a menu
// entry-page landing; productId set + source null = an item detail-page
// view (counted toward "پرطرفدارترین آیتم‌ها", not the source breakdown).
model MenuVisit {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id])
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id])
  source     VisitSource?
  createdAt  DateTime     @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, productId, createdAt])
}

// A submission from the public marketing site's /contact form
// (features/contact) — platform-level inbound leads/support requests, not
// tied to any Business. Distinct from Contact above (a per-business SMS
// phonebook entry) and from Ticket (an authenticated business owner's
// support ticket inside the dashboard).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Blog/article content managed from the super-admin panel
// (features/blog) and served on the public marketing site's /blog pages.
// slug is separate from id (a cuid) so URLs never carry the raw Persian
// title — see the CLAUDE.md note on why an id must never be user-facing text.
model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String     @db.Text
  content     String     @db.Text
  coverImage  String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // SEO
  seoTitle       String?
  seoDescription String?
  seoNoIndex     Boolean @default(false)
  canonicalUrl   String?

  // Relations
  categories BlogPostCategory[]
  tags       BlogPostTag[]

  @@index([status, publishedAt])
}

model BlogCategory {
  id    String             @id @default(cuid())
  name  String             @unique
  slug  String             @unique
  posts BlogPostCategory[]
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String        @unique
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPostCategory {
  postId     String
  categoryId String
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}
