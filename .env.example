DATABASE_URL="postgresql://magmenu:magmenu_dev_password@localhost:5432/magmenu?schema=public"

# S3-compatible storage (MinIO locally via docker-compose) — used by
# features/uploads for product/category/logo image upload. The bucket must
# be configured for public read (no per-object ACL is set on upload).
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="magmenu"
S3_SECRET_KEY="magmenu_dev_password"
S3_BUCKET="magmenu-uploads"
# Optional — only needed if your provider requires a region string
# (AWS S3 always does; many S3-compatible providers ignore it).
# S3_REGION="us-east-1"
# Optional — set this if your provider serves public objects from a
# different domain than S3_ENDPOINT (e.g. a CDN/bucket subdomain on
# ArvanCloud or Liara). Defaults to "<S3_ENDPOINT>/<S3_BUCKET>".
# S3_PUBLIC_URL="https://your-bucket.your-provider.com"

# Session cookie signing — generate with `openssl rand -hex 32`.
SESSION_SECRET="change-me-in-every-real-environment"

# Public base URL of this deploy — used by app/robots.ts's sitemap: line.
# No trailing slash. Falls back to localhost:3000 in dev if unset.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Wildcard subdomain root for the public menu (proxy.ts + lib/subdomain.ts +
# lib/menu-url.ts) — a menu-display business at slug "demo" is canonically
# served at "https://demo.{ROOT_DOMAIN}" once DNS for *.{ROOT_DOMAIN} points
# at this deploy. Until then (or for any plan without that DNS set up), the
# existing path-based "https://{ROOT_DOMAIN}/demo" keeps working as a
# fallback — see getMenuUrl() in lib/menu-url.ts. Falls back to "serwapp.ir"
# if unset.
# ROOT_DOMAIN="serwapp.ir"
#
# Testing subdomain routing locally, without touching DNS, in order of
# effort:
#   1. Query param (zero setup): with ROOT_DOMAIN unset/default, run
#      `npm run dev` and open http://localhost:3000/?preview=demo — the dev
#      server treats this exactly like landing on a subdomain, rewriting to
#      /demo. Only works on the bare root path; after that, in-app
#      navigation is normal path-based routing (see lib/subdomain.ts).
#   2. Real subdomain host (closer to production): set ROOT_DOMAIN=localhost
#      here, then either add "127.0.0.1 demo.localhost" to your hosts file,
#      or just visit http://demo.localhost:3000 directly — most OSes/browsers
#      already resolve *.localhost to 127.0.0.1 with no hosts file edit.

# Melipayamak (شرکت ملی پیامک) — real SMS provider for OTP codes
# (features/auth/services/otp-service.ts), used via the پترن (pattern-based)
# REST API — faster delivery / less likely to be spam-filtered than plain
# text, which is why it's recommended for OTP specifically. Uses
# username+password auth (not a bearer token), so there's no separate
# "API key" var; MELIPAYAMAK_BODY_ID is the id of the pattern approved in
# your Melipayamak panel for the OTP template (its own configured sender
# line is implied by the pattern, so no separate sender-line var either).
# All three optional: unset in local dev, the app falls back to
# MockOtpProvider (logs the code instead of sending an SMS) — only set these
# in production once you have a real Melipayamak account.
# MELIPAYAMAK_USERNAME="09xxxxxxxxx"
# MELIPAYAMAK_PASSWORD="your-melipayamak-panel-password"
# MELIPAYAMAK_BODY_ID="your-approved-otp-pattern-id"

# Google Maps — powers the dashboard's Business Info location picker
# (components/dashboard/location-picker.tsx) and the public menu's map embed
# (components/menu/business-info-modal.tsx). Optional: without it, the
# dashboard falls back to plain lat/lng number inputs and the public menu
# falls back to a "مشاهده در نقشه" link instead of an embedded map.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
